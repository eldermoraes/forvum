<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.forvum</groupId>
        <artifactId>forvum-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>forvum-tools-tts</artifactId>

    <name>Forvum Tools — Text-to-Speech</name>
    <description>Layer-3 Forvum extension (#186): contributes the tts.speak ToolSpec — synthesizing a
        WAV under the workspace by driving the operator-installed piper binary. Pure java.lang Process
        (ProcessBuilder), no AI library; configured by tools/tts.json, inert when unconfigured.</description>

    <properties>
        <!-- @Tag("live") tests (one real piper synthesis — TtsSpeakPiperLiveTest) are off by default.
             Excluded via this Surefire user property (so a bare CLI -DexcludedGroups= re-enables them,
             which a plugin-XML value would NOT — the forvum-tools-browser precedent). Run the live test
             with: -Dgroups=live -DexcludedGroups= -->
        <excludedGroups>live</excludedGroups>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ai.forvum</groupId>
                <artifactId>forvum-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Layer-1 plugin SPI: the ONLY ai.forvum dependency for a Layer-3 extension (enforced below).
             Version managed by forvum-bom. A tts tool uses java.lang Process only — no langchain4j. -->
        <dependency>
            <groupId>ai.forvum</groupId>
            <artifactId>forvum-sdk</artifactId>
        </dependency>
        <!-- CDI (ArC): @ApplicationScoped bean discovery. Version via Quarkus platform BOM. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <!-- Jackson (JsonNode/ObjectMapper) for the on-demand tools/tts.json tree-walk reader. Version
             via Quarkus platform BOM; native-clean (the ShellAllowlist tree-walk-into-plain-record
             pattern, no reflective POJO binding). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jackson</artifactId>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Quarkus codegen + dev/test bootstrap. No `build` goal: forvum-tools-tts is a
                 Layer-3 library, never a runnable artifact (that is forvum-app). -->
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- forvum-tools-tts is a headless Quarkus library with no `build` goal; its
                         *IT tests run via Surefire (CLAUDE.md section 4 exception). @Tag("live") tests
                         (TtsSpeakPiperLiveTest) are excluded by default via the ${excludedGroups} user
                         property (above); opt in with -DexcludedGroups= -Dgroups=live. -->
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-plugin-layering</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <phase>validate</phase>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <!-- Allowlist form (consistent with core/sdk/engine and the other tool/provider
                                         modules): ban every ai.forvum module, re-allow forvum-sdk + forvum-core.
                                         forvum-core is the Layer-0 contract layer the SDK SPI re-exposes
                                         (ToolSpec / PermissionScope in ToolProvider.tools()), so a tool plugin
                                         unavoidably and legitimately compiles against it; what stays banned is
                                         forvum-engine, another extension (incl. forvum-channel-voice), and the app. -->
                                    <includes>
                                        <include>ai.forvum:forvum-sdk</include>
                                        <include>ai.forvum:forvum-core</include>
                                    </includes>
                                    <excludes>
                                        <exclude>ai.forvum:*</exclude>
                                    </excludes>
                                    <searchTransitive>true</searchTransitive>
                                    <message>A Forvum extension (Layer 3) compiles against forvum-sdk + the Layer-0 contracts it re-exposes (forvum-core, e.g. ToolSpec/PermissionScope in the ToolProvider SPI); it must NOT depend on forvum-engine, another extension, or forvum-app. See CLAUDE.md section 12.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
