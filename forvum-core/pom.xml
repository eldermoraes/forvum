<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ai.forvum</groupId>
        <artifactId>forvum-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>forvum-core</artifactId>

    <name>Forvum Core</name>
    <description>Core domain types: sealed interfaces, records, agent/turn/event primitives. Extension-agnostic.</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ai.forvum</groupId>
                <artifactId>forvum-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Layer 0 stays pure Java. The single compile dependency is the Jakarta CDI API, needed only so
         @AgentScoped can be meta-annotated @NormalScope; it is `provided` (compile-only, supplied by
         ArC downstream) and is NOT an io.quarkus*/io.quarkiverse* artifact, so enforce-core-purity
         (below) still passes. Everything else is test scope. Versions come from the Quarkus platform
         BOM imported via forvum-bom. -->
    <dependencies>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-core-purity</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <phase>validate</phase>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <!-- forvum-core is Layer 0: pure Java, no Quarkus / Quarkiverse.
                                             Group-wildcards cover the bare group and every sub-namespace
                                             (io.quarkus, io.quarkus.platform, io.quarkus.arc, io.quarkiverse.*). -->
                                        <exclude>io.quarkus*:*</exclude>
                                        <exclude>io.quarkiverse*:*</exclude>
                                    </excludes>
                                    <searchTransitive>true</searchTransitive>
                                    <message>forvum-core must stay pure Java (Layer 0): no Quarkus / Quarkiverse dependencies. See CLAUDE.md section 3.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Mutation testing (#182): the bounded Pitest signal over Layer-0's pure high-risk logic —
             value/parse validation (ModelRef.parse, PermissionScope.fromName, CostBudget invariants,
             AgentEvent hierarchy), the exact surfaces ULTRAPLAN section 10 names. Deliberately scoped to
             forvum-core only: deterministic, Quarkus-free, seconds-fast — never the whole reactor.
             Run locally / in CI (.github/workflows/mutation.yml) with:
                 ./mvnw -Pmutation -pl forvum-core test-compile org.pitest:pitest-maven:mutationCoverage
             The thresholds are the committed RATCHET: mutationThreshold / testStrengthThreshold sit just
             below the measured baseline (97%/97% over 175 mutants), so a regression fails the run while
             normal drift does not. Raise
             them (never lower, .github/coverage-policy.sh guards the direction) as the score improves
             toward the ULTRAPLAN 70% Phase-2 target. Reports: target/pit-reports (HTML + XML).
             Surviving-mutant triage: docs/ULTRAPLAN.md section 10; suppress nothing by exclusion —
             a surviving mutant is either killed by a new assertion or accepted in review. -->
        <profile>
            <id>mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest-maven.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest-junit5-plugin.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>ai.forvum.core.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>ai.forvum.core.*</param>
                            </targetTests>
                            <mutators>
                                <mutator>DEFAULTS</mutator>
                            </mutators>
                            <!-- Ratchet floor (#182): measured baseline at introduction was 97% killed /
                                 97% test strength over 175 mutants (0 with no coverage); the thresholds
                                 sit a hair below so real regressions fail while equivalent-mutant noise
                                 does not. Never lower (.github/coverage-policy.sh guards the direction). -->
                            <mutationThreshold>95</mutationThreshold>
                            <testStrengthThreshold>95</testStrengthThreshold>
                            <timestampedReports>false</timestampedReports>
                            <outputFormats>
                                <outputFormat>HTML</outputFormat>
                                <outputFormat>XML</outputFormat>
                            </outputFormats>
                            <threads>2</threads>
                            <timeoutConstant>8000</timeoutConstant>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
